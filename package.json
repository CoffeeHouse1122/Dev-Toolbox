{
  "name": "dev-toolbox",
  "version": "0.1.2",
  "author": "qiuzhaopeng",
  "description": "Local-first desktop toolkit for frontend asset conversion.",
  "productName": "Dev Toolbox",
  "main": "dist/electron/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/dev-electron.cjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json && node scripts/prepare-build-config.cjs",
    "build:renderer": "vite build",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "vue-tsc --noEmit",
    "test": "npm run build:main && node --test tests/*.test.cjs",
    "test:electron": "npm run build:main && electron tests/electron-smoke.cjs",
    "check": "npm run typecheck && npm test && npm run test:electron && npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.5",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^13.0.3",
    "blurhash": "^2.0.5",
    "clean-css": "^5.3.3",
    "ffmpeg-static": "^5.2.0",
    "fonteditor-core": "^2.4.0",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "markdown-it": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "sql.js": "^1.12.0",
    "terser": "^5.48.0",
    "wawoff2": "^2.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/clean-css": "^4.2.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/typescript-plugin": "^3.2.8",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "js-yaml": "^5.2.3",
    "pinia": "^3.0.4",
    "remixicon": "^4.9.1",
    "simplebar": "^6.3.3",
    "smol-toml": "^1.7.1",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.8",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "minimatch@<10.0.0": {
      "brace-expansion": "2.1.4"
    }
  },
  "build": {
    "appId": "com.devtoolbox.app",
    "productName": "Dev Toolbox",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "favicon.ico",
          "favicon-256x256.png"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/wawoff2/**/*",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "icon": "build/icons/favicon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/favicon-256x256.png"
    }
  }
}

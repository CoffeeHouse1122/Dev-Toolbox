{
  "name": "dev-toolbox",
  "version": "0.1.1",
  "author": "qiuzhaopeng",
  "description": "Local-first desktop toolkit for frontend asset conversion.",
  "productName": "Dev Toolbox",
  "main": "dist/electron/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm-run-all -p dev:renderer dev:electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm-run-all build:main build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "npm-run-all build:main typecheck:renderer",
    "typecheck:renderer": "vue-tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^13.1.0",
    "autoprefixer": "^10.5.0",
    "blurhash": "^2.0.5",
    "clean-css": "^5.3.3",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "fonteditor-core": "^2.4.0",
    "html-to-image": "^1.11.13",
    "http-mitm-proxy": "^1.1.0",
    "js-yaml": "^4.1.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^3.0.2",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "remixicon": "^4.9.1",
    "sharp": "^0.34.1",
    "simplebar": "^6.3.3",
    "smol-toml": "^1.6.1",
    "sql.js": "^1.12.0",
    "terser": "^5.48.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "wawoff2": "^2.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/clean-css": "^4.2.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/typescript-plugin": "^3.2.8",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.devtoolbox.app",
    "productName": "Dev Toolbox",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/wawoff2/**/*",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "icon": "build/icons/favicon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/favicon-256x256.png"
    },
    "publish": {
      "provider": "generic",
      "url": "https://your-server.com/releases/"
    }
  }
}

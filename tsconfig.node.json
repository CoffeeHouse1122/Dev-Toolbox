{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src/electron/main/**/*.ts",
    "src/electron/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}

